{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "p2p-ethsltd-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://p2p-api.ethsltd.workers.dev"
  }
}
